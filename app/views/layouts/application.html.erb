<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "walking monster" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <style>
      /* Leafletカスタムアイコン: 白ボックス除去 */
      .custom-map-icon, .leaflet-div-icon { background: none !important; border: none !important; }
      /* 地図タイルにRPG風セピアフィルター */
      .leaflet-tile-pane { filter: sepia(0.35) saturate(1.3) hue-rotate(5deg) contrast(1.05); }
      /* 洞窟popupのスタイル */
      .cave-popup .leaflet-popup-content-wrapper {
        background: rgba(30,20,10,0.85);
        border: 2px solid #8b6914;
        border-radius: 12px;
        box-shadow: 0 0 12px rgba(139,105,20,0.6);
        color: white;
      }
      .cave-popup .leaflet-popup-tip { background: rgba(30,20,10,0.85); }
    </style>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= include_gon %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MTBPWMHXH5"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-MTBPWMHXH5');
    </script>
  </head>

<body>
  <div class="flex flex-col min-h-screen">
    <% if user_signed_in? %>
    <!-- PC版ヘッダー -->
    <div class="hidden lg:block">
      <%= render 'shared/header' %>
    </div>

    <!-- スマホ版ヘッダー -->
    <div class="flex lg:hidden">
      <%= render 'shared/header_sp' %>
    </div>
  
    <% else %>
      <%= render 'shared/before_login_header' %>
    <% end %>

    <main class="flex-1 pt-16 pb-16">
      <%= yield %>
    </main>

    <!-- PC版フッター -->
    <div class="hidden lg:block">
      <%= render 'shared/footer' %>
    </div>

    <!-- スマホ版フッター -->
    <div class="flex lg:hidden">
      <%= render 'shared/footer_sp' %>
    </div>

  </div>
</body>
</html>
