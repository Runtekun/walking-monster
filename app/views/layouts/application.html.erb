<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "walking monster" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <style>
      /* Leafletカスタムアイコン: 白ボックス除去 */
      .leaflet-div-icon { background: none !important; border: none !important; }
      /* 地図タイルにRPG風セピアフィルター */
      .leaflet-tile-pane { filter: sepia(0.35) saturate(1.3) hue-rotate(5deg) contrast(1.05); }
      /* 現在地ボタン（白い四角・地図アプリ標準スタイル） */
      .locate-control-btn {
        width: 34px; height: 34px;
        background: white;
        border: none;
        border-radius: 4px;
        box-shadow: 0 1px 5px rgba(0,0,0,0.3);
        font-size: 18px;
        cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.15s;
      }
      .locate-control-btn:hover { background: #f4f4f4; }
      /* ⚔️ 青グロー（現在地） */
      .hero-glow {
        font-size: 28px;
        text-align: center;
        line-height: 40px;
        filter: drop-shadow(0 0 6px #60a5fa) drop-shadow(0 0 12px #3b82f6);
        animation: hero-pulse 2s ease-in-out infinite;
      }
      @keyframes hero-pulse {
        0%, 100% { filter: drop-shadow(0 0 6px #60a5fa) drop-shadow(0 0 12px #3b82f6); }
        50%       { filter: drop-shadow(0 0 10px #93c5fd) drop-shadow(0 0 20px #60a5fa); }
      }
      /* 🏰 ゴールドglow（目的地popup） */
      .goal-popup .leaflet-popup-content-wrapper {
        background: rgba(20,15,5,0.88);
        border: 2px solid #fbbf24;
        border-radius: 12px;
        box-shadow: 0 0 14px rgba(251,191,36,0.7), 0 0 28px rgba(251,191,36,0.3);
        color: white;
        animation: goal-pulse 2s ease-in-out infinite;
      }
      .goal-popup .leaflet-popup-tip { background: rgba(20,15,5,0.88); }
      @keyframes goal-pulse {
        0%, 100% { box-shadow: 0 0 14px rgba(251,191,36,0.7), 0 0 28px rgba(251,191,36,0.3); }
        50%       { box-shadow: 0 0 20px rgba(251,191,36,0.9), 0 0 40px rgba(251,191,36,0.5); }
      }
    </style>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= include_gon %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MTBPWMHXH5"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-MTBPWMHXH5');
    </script>
  </head>

<body>
  <div class="flex flex-col min-h-screen">
    <% if user_signed_in? %>
    <!-- PC版ヘッダー -->
    <div class="hidden lg:block">
      <%= render 'shared/header' %>
    </div>

    <!-- スマホ版ヘッダー -->
    <div class="flex lg:hidden">
      <%= render 'shared/header_sp' %>
    </div>
  
    <% else %>
      <%= render 'shared/before_login_header' %>
    <% end %>

    <main class="flex-1 pt-16 pb-16">
      <%= yield %>
    </main>

    <!-- PC版フッター -->
    <div class="hidden lg:block">
      <%= render 'shared/footer' %>
    </div>

    <!-- スマホ版フッター -->
    <div class="flex lg:hidden">
      <%= render 'shared/footer_sp' %>
    </div>

  </div>
</body>
</html>
