<div class="w-full min-h-screen relative"
     style="background-image: url(<%= asset_path('destinations-bg.jpg') %>);
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;">
  <div class="absolute inset-0 z-0"></div>

  <div class="relative z-10 flex justify-center items-start pt-6 pb-16 min-h-screen">
    <div class="w-full max-w-3xl bg-white bg-opacity-90 rounded-xl shadow-xl px-6 py-8 font-[PixelMplus10]">

      <div class="text-center mb-6">
        <h1 class="text-3xl font-bold text-[#3a1e00]">🗺️ 冒険に出かけよう！</h1>
        <p class="text-sm text-[#5f4b32] mt-1">目的地をタップまたは検索して「出発する」を押してね</p>
      </div>

      <!-- モンスターステータス -->
      <% if @user_monster %>
        <div class="flex items-center gap-4 bg-[#fff4d1] border-2 border-yellow-300 rounded-lg p-4 shadow-md mb-6">
          <%
            image_to_display = @species&.image_for_level(@user_monster.level) rescue nil
          %>
          <% if image_to_display&.present? %>
            <%= image_tag image_to_display.url, class: "w-14 h-14 object-contain" %>
          <% else %>
            <div class="w-14 h-14 flex items-center justify-center text-4xl">🐾</div>
          <% end %>
          <div>
            <p class="text-lg font-bold text-[#4b3300]">Lv<%= @user_monster.level %></p>
            <div class="w-40 bg-yellow-200 h-3 rounded-full overflow-hidden">
              <% percent = ((@user_monster.experience.to_f / [@user_monster.next_level_experience, 1].max) * 100).floor %>
              <div class="bg-green-500 h-full" style="width: <%= percent %>%"></div>
            </div>
            <p class="text-xs text-gray-700 mt-1"><%= @user_monster.experience %> / <%= @user_monster.next_level_experience %> XP</p>
          </div>
          <div class="ml-auto text-right text-sm text-gray-600">
            <p>冒険履歴：<strong><%= current_user.total_adventure_count %>回</strong></p>
          </div>
        </div>
      <% end %>

      <!-- GPS取得中インジケーター -->
      <div id="gps-loading-index" class="bg-yellow-50 border border-yellow-200 text-yellow-700 rounded-lg p-2 mb-4 text-sm text-center animate-pulse">
        📡 現在地を取得中...
      </div>

      <!-- スマホ以外への警告 -->
      <div id="no-gps-warning" class="hidden bg-red-100 border border-red-300 text-red-700 rounded-lg p-3 mb-4 text-sm text-center">
        ⚠️ GPS機能はスマートフォンでご利用ください
      </div>

      <!-- 住所検索 -->
      <div class="bg-white border border-yellow-300 p-4 rounded-xl shadow mb-4">
        <label class="text-sm font-bold text-[#3e2c00] block mb-2">🔍 目的地を検索</label>
        <div class="flex gap-2">
          <input id="address-search" type="text" placeholder="例：東京駅、上野公園"
                 class="flex-1 px-4 py-2 border rounded-lg border-yellow-400 bg-yellow-50 focus:outline-none focus:ring-2 focus:ring-yellow-300" />
          <button onclick="searchAddress()"
                  class="px-4 py-2 bg-yellow-400 hover:bg-yellow-500 text-white font-bold rounded-lg shadow">
            検索
          </button>
        </div>
        <p class="text-xs text-gray-500 mt-1">または地図をタップして目的地を設定</p>
      </div>

      <!-- Leaflet地図 -->
      <div class="rounded-lg overflow-hidden border-2 border-yellow-300 shadow-xl mb-4">
        <div id="map" class="w-full h-[350px]"></div>
      </div>

      <!-- 目的地情報 -->
      <div id="destination-info" class="hidden text-center font-bold text-[#3e2c00] mb-4 bg-yellow-50 p-3 rounded-lg border border-yellow-200">
        <p id="destination-address" class="text-sm"></p>
      </div>

      <!-- 出発フォーム -->
      <%= form_with url: destinations_path, method: :post, id: "departure-form" do %>
        <%= hidden_field_tag 'destination[start]', '現在地', id: 'hidden_start' %>
        <%= hidden_field_tag 'destination[end]', nil, id: 'hidden_end' %>
        <%= hidden_field_tag 'destination[latitude]', nil, id: 'hidden_lat' %>
        <%= hidden_field_tag 'destination[longitude]', nil, id: 'hidden_lng' %>
        <%= hidden_field_tag 'destination[address]', nil, id: 'hidden_address' %>

        <button type="submit" id="departure-btn" disabled
                class="w-full py-3 bg-gray-400 text-white font-bold rounded-lg shadow-xl text-lg transition cursor-not-allowed">
          🚀 出発する（目的地を選んでください）
        </button>
      <% end %>

      <!-- 冒険履歴 -->
      <div class="bg-white border border-yellow-300 rounded-xl shadow p-4 mt-6">
        <h2 class="text-xl font-bold text-[#3e2c00] mb-4">📜 冒険の記録</h2>
        <% if @destinations.any? %>
          <% @destinations.order(created_at: :desc).each do |d| %>
            <div class="flex justify-between items-center bg-yellow-50 p-3 rounded-lg mb-2">
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-[#3e2c00] truncate"><%= d.start %> → <%= d.end %></p>
                <p class="text-sm text-gray-600"><%= d.distance.presence || "距離未記録" %></p>
              </div>
              <div class="flex items-center gap-2 shrink-0 ml-4">
                <% if d.walked_at.nil? && d.latitude.present? %>
                  <%= link_to "続きを歩く", walking_destination_path(d),
                      class: "px-3 py-1 bg-green-500 text-white text-sm rounded hover:bg-green-600 transition" %>
                <% elsif d.walked_at.present? %>
                  <span class="text-gray-500 text-sm">✅ 完了</span>
                <% end %>
                <%= link_to "詳細", destination_path(d),
                    class: "px-3 py-1 bg-blue-500 text-white text-sm rounded hover:bg-blue-600 transition" %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-500 text-sm">まだ冒険の記録がありません。</p>
        <% end %>
      </div>

    </div>
  </div>
</div>

<script>
  let map, currentMarker, destinationMarker, myLat, myLng, watchId

  document.addEventListener("turbo:load", () => {
    if (!document.getElementById("map")) return
    initLeafletMap()
  })

  document.addEventListener("turbo:before-cache", () => {
    if (watchId) { navigator.geolocation.clearWatch(watchId); watchId = null }
    if (map) { map.remove(); map = null }
    currentMarker = null // ← リセット必須：次回initで再生成させる
    destinationMarker = null
    myLat = undefined; myLng = undefined
  })

  function initLeafletMap() {
    map = L.map("map").setView([35.681, 139.767], 14)
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map)

    if (navigator.geolocation) {
      // walkingと同じwatchPositionで継続的に現在地を追跡
      watchId = navigator.geolocation.watchPosition(
        (pos) => {
          const lat = pos.coords.latitude
          const lng = pos.coords.longitude
          myLat = lat; myLng = lng
          // ローディング表示を消す
          const loading = document.getElementById('gps-loading-index')
          if (loading) loading.remove()
          // 初回のみ地図を現在地に移動
          if (!currentMarker) {
            map.setView([lat, lng], 16)
            const heroIcon = L.divIcon({
              html: '<div class="hero-glow">⚔️</div>',
              className: '',
              iconSize: [36, 36],
              iconAnchor: [18, 18]
            })
            currentMarker = L.marker([lat, lng], { icon: heroIcon }).addTo(map)
          } else {
            currentMarker.setLatLng([lat, lng])
          }
        },
        () => {
          const loading = document.getElementById('gps-loading-index')
          if (loading) loading.remove()
          document.getElementById("no-gps-warning").classList.remove("hidden")
        },
        { enableHighAccuracy: true, maximumAge: 5000 }
      )
    } else {
      document.getElementById("no-gps-warning").classList.remove("hidden")
    }

    map.on("click", (e) => setDestinationMarker(e.latlng.lat, e.latlng.lng))

    // 現在地ボタン（L.Control で bottomleft）
    const LocateControl = L.Control.extend({
      options: { position: 'bottomleft' },
      onAdd() {
        const btn = L.DomUtil.create('button', 'locate-control-btn')
        btn.innerHTML = '📍'
        btn.title = '現在地に移動'
        L.DomEvent.disableClickPropagation(btn)
        btn.addEventListener('click', locateMe)
        return btn
      }
    })
    new LocateControl().addTo(map)
  }

  function setDestinationMarker(lat, lng) {
    if (destinationMarker) map.removeLayer(destinationMarker)
    const goalIcon = L.divIcon({
      html: '<div class="goal-glow">🏰<br><span style="font-size:12px;font-weight:bold;color:#ffd700;text-shadow:0 1px 3px #000,0 0 6px #000">目的地</span></div>',
      className: '',
      iconSize: [60, 58],
      iconAnchor: [30, 29]
    })
    destinationMarker = L.marker([lat, lng], { icon: goalIcon }).addTo(map)

    document.getElementById("hidden_lat").value = lat
    document.getElementById("hidden_lng").value = lng

    fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`, {
      headers: { "Accept-Language": "ja" }
    })
      .then(r => r.json())
      .then(data => {
        const address = data.display_name || `${lat.toFixed(5)}, ${lng.toFixed(5)}`
        document.getElementById("hidden_end").value = address
        document.getElementById("hidden_address").value = address
        document.getElementById("destination-address").textContent = `🏁 目的地: ${address}`
        document.getElementById("destination-info").classList.remove("hidden")
        enableDepartureButton()
      })
      .catch(() => {
        const fallback = `${lat.toFixed(5)}, ${lng.toFixed(5)}`
        document.getElementById("hidden_end").value = fallback
        document.getElementById("hidden_address").value = fallback
        enableDepartureButton()
      })
  }

  function searchAddress() {
    const query = document.getElementById("address-search").value
    if (!query) return

    fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&limit=1`, {
      headers: { "Accept-Language": "ja" }
    })
      .then(r => r.json())
      .then(results => {
        if (results.length === 0) { alert("住所が見つかりませんでした"); return }
        const { lat, lon } = results[0]
        map.setView([parseFloat(lat), parseFloat(lon)], 16)
        setDestinationMarker(parseFloat(lat), parseFloat(lon))
      })
      .catch(() => alert("住所の検索に失敗しました"))
  }

  function locateMe() {
    if (myLat !== undefined) {
      map.setView([myLat, myLng], 16)
    } else if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition((pos) => {
        myLat = pos.coords.latitude
        myLng = pos.coords.longitude
        map.setView([myLat, myLng], 16)
      })
    }
  }

  function enableDepartureButton() {
    const btn = document.getElementById("departure-btn")
    btn.disabled = false
    btn.className = "w-full py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg shadow-xl text-lg transition cursor-pointer"
    btn.textContent = "🚀 出発する！"
  }
</script>
